rules_version = '2';
// SchoolFlo Firebase project (schoolflo.org only). Paste ALL of this into
// Firebase console > Firestore Database > Rules, then Publish.
//
// PVHS Digital Media interest form (schoolflo.org/pvhs/signup.html and /pvhs/es/signup.html).
// Anyone can submit one validated sign up (create only, no reading back). Only the program
// owner can read, print, or delete them (schoolflo.org/pvhs/admin.html). Everything else is closed.
service cloud.firestore {
  match /databases/{db}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'creativesilva1@gmail.com';
    }
    function str(v, max) { return v is string && v.size() <= max; }

    match /pvhs_interest/{id} {
      allow read, delete: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['name', 'sid', 'grade', 'schoolYear', 'courses', 'source', 'lang', 'note', 'at'])
        && request.resource.data.keys().hasAll(['name', 'sid', 'grade', 'schoolYear', 'courses', 'source', 'lang', 'at'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() >= 2
        && request.resource.data.sid is string && request.resource.data.sid.matches('^[0-9]{6}$')
        && request.resource.data.grade in [9, 10, 11, 12]
        && request.resource.data.schoolYear is string && request.resource.data.schoolYear.matches('^20[0-9]{2}-20[0-9]{2}$')
        && request.resource.data.courses is list && request.resource.data.courses.size() >= 1 && request.resource.data.courses.size() <= 6
        && request.resource.data.courses.hasOnly(['Photography 1', 'Photography 2', 'Digital Arts 1', 'Digital Arts 2', 'Intro to Art', 'Painting'])
        && str(request.resource.data.source, 64)
        && request.resource.data.lang in ['en', 'es']
        && (!('note' in request.resource.data) || str(request.resource.data.note, 500))
        && request.resource.data.at == request.time;
    }

    // Anything not listed above is denied.
    match /{document=**} { allow read, write: if false; }
  }
}
